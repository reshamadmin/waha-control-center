# Server Environment Configuration
PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:3003

# Database configuration
DB_ROOT_PASSWORD=your_root_database_password
DB_USER_PASSWORD=your_admin_user_password
DATABASE_URL=mysql://waha_admin:your_admin_user_password@localhost:3306/waha_control_center

# WAHA Settings
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=waha_secret_api_key

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key

# Session Auth (Secret must be at least 32 characters)
SESSION_SECRET=your_32_character_hex_session_secret_key

# Cryptography (Encryption key must be exactly 64-character hex string)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_for_secrets

# Supabase (PostgreSQL Database Client - Inherits from CRM .env by default)
SUPABASE_URL=https://cdndktqfizfmijybekhe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
